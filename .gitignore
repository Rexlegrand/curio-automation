remotion/public/curio_motion/*
!remotion/public/curio_motion/img_eclipse.jpg
!remotion/public/curio_motion/img_tdf.jpg
!remotion/public/curio_motion/img_stadium.jpg
!remotion/public/curio_motion/img_football_kid.jpg

